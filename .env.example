JUPYTER_PORT=8888
OPENCODE_PORT=4096
BIND_ADDRESS=0.0.0.0
JUPYTER_DATA_DIR=./jupyter-data
OPENCODE_PROJECT_DIR=project
# Optional public HTTPS repository to clone into OPENCODE_PROJECT_DIR.
OPENCODE_PROJECT_GIT_URL=
# Host SSH access is provisioned automatically on CloudLab. Leave disabled locally.
HOST_SSH_ENABLED=0
# GPU_MODE may be auto, cpu, or gpu. auto falls back to CPU when unavailable.
GPU_MODE=auto
# Host driver installation is potentially disruptive; leave disabled by default.
ALLOW_HOST_NVIDIA_DRIVER_INSTALL=0
JUPYTER_TOKEN=replace-with-a-long-random-token
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-password
